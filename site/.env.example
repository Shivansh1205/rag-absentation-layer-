# Copy to .env.local for local dev overrides (Vite loads .env.local
# automatically, and it's gitignored by Vite's default template).
#
# URL of the live-scoring API (see ../api/). Defaults to
# http://localhost:8000 in code if this is unset, so .env.local is only
# needed if your API runs somewhere else -- and it's required in
# production deploys (Vercel/Netlify), where it should point at your
# deployed api/ instance (Render/Railway/Fly.io).
VITE_API_URL=http://localhost:8000
